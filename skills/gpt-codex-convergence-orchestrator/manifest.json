{
  "skill_id": "gpt-codex-convergence-orchestrator",
  "version": "1.4.2",
  "display_name": "GPT-Codex 自动闭环",
  "method_dependency": "first-principles-physical-limit-convergence@3.1.1",
  "architecture": "GITHUB_PRIMARY_PAGE_FALLBACK",
  "roles": {
    "gpt": "PLANNER_JUDGE",
    "codex": "EXECUTOR",
    "browser": "TRANSPORT",
    "github": "PREFERRED_SHARED_WORKSPACE"
  },
  "transport": {
    "primary": "GITHUB",
    "fallback": "PAGE_DIRECT",
    "fallback_triggers": [
      "GITHUB_WRITE_BLOCKED",
      "GITHUB_WRITE_ERROR",
      "GITHUB_WRITE_SAFETY_CHECK",
      "TRANSPORT_DELAY_NOT_WORTH_WAITING"
    ],
    "github_repair_blocks_task": false,
    "browser_business_payload_allowed_in_fallback": true
  },
  "thinking_timeout": {
    "SIMPLE_SECONDS": 60,
    "NORMAL_SECONDS": 180,
    "LARGE_SECONDS": 600,
    "scope": "BEFORE_FIRST_VISIBLE_ANSWER_ONLY"
  },
  "simple_resilience": {
    "rule": "PRIMARY -> ONE_SIMPLE_RECOVERY -> FALLBACK -> CONTINUE",
    "simple_recovery_attempts": 1,
    "stop_only_if": [
      "PRIMARY_AND_FALLBACK_BOTH_FAIL",
      "VALID_WOULD_BE_BROKEN",
      "SAFETY_OR_PERMISSION_BOUNDARY"
    ],
    "recurrent_fault_policy": "SOLVE_SEPARATELY_IF_IT_BECOMES_PERSISTENT",
    "occasional_fault_policy": "RECORD_AND_BYPASS"
  }
}
