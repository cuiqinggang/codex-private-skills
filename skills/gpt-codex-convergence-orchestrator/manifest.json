{
  "skill_id": "gpt-codex-convergence-orchestrator",
  "version": "1.5.0",
  "display_name": "GPT-Codex 简洁自动闭环",
  "method_dependency": "first-principles-physical-limit-convergence@3.1.1",
  "architecture": "PAGE_DIRECT_CONTROL_GITHUB_OPTIONAL_MIRROR",
  "core_mapping": {
    "core_1": "MINIMIZE_T_VALID",
    "core_2": "REUSE_MATURE_BROWSER_GPT_CODEX_AND_OPTIONAL_GITHUB",
    "core_3": "FREEZE_PAGE_DIRECT_CONTROL_LOOP"
  },
  "roles": {
    "gpt": "PLANNER_JUDGE",
    "browser": "TRANSPORT",
    "codex": "DETERMINISTIC_EXECUTOR",
    "github": "OPTIONAL_MIRROR_EVIDENCE_BACKUP"
  },
  "control_loop": [
    "CODEX_PREPARE_CONTEXT",
    "BROWSER_SEND_TO_GPT",
    "GPT_COMMAND",
    "BROWSER_EXTRACT",
    "CODEX_EXECUTE_VERIFY",
    "BROWSER_SEND_RESULT_TO_GPT",
    "GPT_DECISION",
    "CODEX_CONTINUE_OR_STOP"
  ],
  "github_required_for_control": false,
  "fault_policy": "ONE_SIMPLE_RECOVERY_THEN_BYPASS",
  "thinking_timeout": {
    "SIMPLE_SECONDS": 60,
    "NORMAL_SECONDS": 180,
    "LARGE_SECONDS": 600,
    "scope": "BEFORE_FIRST_VISIBLE_ANSWER_ONLY"
  },
  "minimal_state": [
    "TASK_ID",
    "CURRENT_STEP",
    "LAST_GPT_COMMAND_HASH",
    "LAST_RESULT",
    "DONE"
  ],
  "plan_status": "FROZEN",
  "real_execution_status": "NOT_RUN_UNDER_V1_5"
}
