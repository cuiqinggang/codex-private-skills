{
  "skill_id": "gpt-codex-convergence-orchestrator",
  "version": "1.5.1",
  "display_name": "GPT-Codex 简洁灵活自动闭环",
  "method_dependency": "first-principles-physical-limit-convergence@3.1.1",
  "architecture": "PREFERRED_SHARED_WORKSPACE_WITH_SIMPLE_FALLBACKS",
  "roles": {
    "gpt": "PLANNER_JUDGE",
    "codex": "DETERMINISTIC_EXECUTOR",
    "browser": "PAGE_TRANSPORT",
    "github": "PREFERRED_SHARED_WORKSPACE"
  },
  "paths": {
    "A": {
      "name": "SHARED_WORKSPACE_FULL",
      "priority": 1,
      "use_when": "GITHUB_READ_WRITE_OK"
    },
    "B": {
      "name": "SHARED_WORKSPACE_READ_PAGE_REPLY",
      "priority": 2,
      "use_when": "GITHUB_READ_OK_WRITE_BLOCKED"
    },
    "C": {
      "name": "PAGE_DIRECT",
      "priority": 3,
      "use_when": "GITHUB_UNAVAILABLE_OR_NOT_WORTH_WAITING"
    }
  },
  "switching_rule": "A_IF_AVAILABLE_ELSE_B_IF_READ_AVAILABLE_ELSE_C",
  "simple_recovery_attempts": 1,
  "stop_only_if": [
    "A_B_C_ALL_UNAVAILABLE",
    "VALID_WOULD_BREAK",
    "SAFETY_OR_PERMISSION_BOUNDARY",
    "USER_STOP"
  ],
  "thinking_timeout": {
    "SIMPLE_SECONDS": 60,
    "NORMAL_SECONDS": 180,
    "LARGE_SECONDS": 600,
    "scope": "BEFORE_FIRST_VISIBLE_ANSWER_ONLY"
  },
  "minimal_state": [
    "TASK_ID",
    "CURRENT_STEP",
    "ACTIVE_PATH",
    "LAST_GPT_COMMAND_HASH",
    "LAST_RESULT",
    "DONE"
  ],
  "plan_status": "FROZEN",
  "real_execution_status": "NOT_RUN_UNDER_V1_5_1"
}
