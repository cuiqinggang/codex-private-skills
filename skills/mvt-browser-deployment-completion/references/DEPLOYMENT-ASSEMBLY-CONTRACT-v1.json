    "D003": {
      "name": "CONDITION_STATE_MACHINE",
      "output": "condition-state-machines.json",
      "conditions": {
        "COLD": [
          "ASSERT_BROWSER_ABSENT",
          "TASK_ACCEPTED",
          "TIMER_START",
          "LAUNCH",
          "RUN",
          "INDEPENDENT_VERIFY_VALID",
