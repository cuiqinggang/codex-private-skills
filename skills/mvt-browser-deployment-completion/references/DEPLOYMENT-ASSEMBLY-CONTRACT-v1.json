          "TASK_ACCEPTED",
          "TIMER_START",
          "RUN",
          "INDEPENDENT_VERIFY_VALID",
          "TIMER_STOP",
          "RESTORE_NEXT_INITIAL_STATE_OUTSIDE_ATTEMPT"
        ],
        "RECONNECT": [
          "ASSERT_BROWSER_ALIVE",
          "DISCONNECT_CONTROLLER",
          "TASK_ACCEPTED",
          "TIMER_START",
          "RECONNECT",
          "RUN",
          "INDEPENDENT_VERIFY_VALID",
          "TIMER_STOP"
        ]
      }
    },
    "D004": {
      "name": "T_VALID_FULL_RECORDER",
      "output": "t-valid-full-record-contract.json",
      "clock": "MONOTONIC_HIGH_RESOLUTION",
      "formula": "t_valid_full_ms=end_monotonic_ms-start_monotonic_ms",
      "required_fields": [
        "route_id",
        "family",
        "case_id",
        "condition",
        "attempt_index",
        "start_monotonic_ms",
        "end_monotonic_ms",
        "t_valid_full_ms",
        "component_times",
        "valid",
        "verifier_result",
        "model_calls",
        "jev_calls",
        "open_agent_calls",
        "recovery_triggered",
        "error",
        "artifacts",
        "contract_version",
        "source_commit"
      ],
      "timing_boundary_overrides": 0
    },
    "D005": {
      "name": "RESULT_PIPELINE",
      "output": "result-pipeline.json",
      "sequence": [
        "RUNNER_RESULT",
        "INDEPENDENT_VERIFIER",
        "NORMALIZED_ATTEMPT",
        "APPEND_ONLY_JSONL",
        "STATISTICS",
        "PROVISIONAL_WINNER_SELECTOR",
        "ARTIFACT_HASHES"
      ],
      "append_only": true,
      "dropped_failures": 0,
      "winner_rule": [
        "VALID_FIRST",
        "MINIMUM_T_VALID_FULL",
        "EXACT_TIE_REMAINS_TIE",
        "NO_SECOND_KPI"
      ]
    },
    "D006": {
      "name": "CAPABILITY_MATRIX_BINDING",
      "output": "capability-execution-matrix.json",
      "source": "STEP1_CAPABILITY_MATRIX",
      "each_case_requires": [
        "case_id",
        "capability",
        "status",
        "route_binding",
        "fixture_or_request",
        "expected",
        "verifier",
        "repeat_count"
      ],
      "missing_required_binding_action": "CAPABILITY_UNKNOWN_AND_OVERALL_NOT_COMPLETE"
    },
    "D007": {
      "name": "RECOVERY_EXECUTION_BINDING",
      "output": "recovery-execution-bindings.json",
      "faults": [
        "SESSION_LOST",
        "STALE_STATE",
        "TARGET_CHANGED",
        "BROWSER_CRASH",
        "NETWORK_INTERRUPTION",
        "CONTRACT_DRIFT"
      ],
      "each_fault_requires": [
        "fault_injector",
        "recovery_runner",
        "verifier",
        "repeat_count",
        "result_record"
      ],
      "repeat_count": 3,
      "normal_path_recovery_overhead": 0
