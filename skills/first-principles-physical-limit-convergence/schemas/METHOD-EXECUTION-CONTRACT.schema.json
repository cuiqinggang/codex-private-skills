{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Method Execution Contract v3.1",
  "type": "object",
  "required": [
    "task_id",
    "method_version",
    "task_contract_hash",
    "valid_contract_hash",
    "authorization_plan",
    "execution_mode",
    "authorized_actions",
    "runtime_policy"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "method_version": {"const": "3.1.0"},
    "task_contract_hash": {"type": "string", "minLength": 8},
    "valid_contract_hash": {"type": "string", "minLength": 8},
    "resource_boundary_hash": {"type": ["string", "null"]},
    "authorization_plan": {
      "type": "object",
      "required": ["plan_type", "plan_id", "plan_hash", "plan_status"],
      "properties": {
        "plan_type": {"enum": ["CALIBRATION_PLAN", "VIRTUAL_99_FINAL_PLAN"]},
        "plan_id": {"type": "string", "minLength": 1},
        "plan_hash": {"type": "string", "minLength": 8},
        "plan_status": {"const": "FROZEN"}
      },
      "additionalProperties": false
    },
    "execution_mode": {
      "enum": ["MINIMAL_CALIBRATION", "FINAL_CERTIFICATION"]
    },
    "authorized_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "authorized_step",
          "action_class",
          "expected_evidence",
          "verifier",
          "failure_policy"
        ],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "authorized_step": {"type": "string", "minLength": 1},
          "action_class": {
            "enum": [
              "CALIBRATION",
              "CERTIFICATION",
              "VERIFY",
              "RECORD",
              "CHECKPOINT_RESUME",
              "AUTHORIZED_CONTROL_RECOVERY",
              "AUTHORIZED_ROLLBACK",
              "REMOTE_VERIFY",
              "STOP"
            ]
          },
          "immutable_parameters": {"type": "object"},
          "expected_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "verifier": {"type": "string", "minLength": 1},
          "failure_policy": {"const": "STOP_SAVE_EVIDENCE_RETURN_TO_GPT"}
        },
        "additionalProperties": true
      }
    },
    "runtime_policy": {
      "type": "object",
      "required": [
        "fail_closed",
        "no_free_exploration",
        "plan_mutation_allowed",
        "unauthorized_action_policy",
        "legacy_execution_authority",
        "current_method_precedence"
      ],
      "properties": {
        "fail_closed": {"const": true},
        "no_free_exploration": {"const": true},
        "plan_mutation_allowed": {"const": false},
        "unauthorized_action_policy": {"const": "DENY_STOP_RETURN_TO_GPT"},
        "legacy_execution_authority": {"const": "NONE"},
        "current_method_precedence": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"execution_mode": {"const": "MINIMAL_CALIBRATION"}}},
      "then": {
        "properties": {
          "authorization_plan": {
            "properties": {"plan_type": {"const": "CALIBRATION_PLAN"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"execution_mode": {"const": "FINAL_CERTIFICATION"}}},
      "then": {
        "properties": {
          "authorization_plan": {
            "properties": {"plan_type": {"const": "VIRTUAL_99_FINAL_PLAN"}}
          }
        }
      }
    }
  ],
  "additionalProperties": true
}