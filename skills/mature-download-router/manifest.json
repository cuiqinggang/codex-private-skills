{
  "skill_id": "mature-download-router",
  "version": "1.0.0",
  "display_name": "成熟下载工具最短调用路由",
  "status": "STABLE_MINIMAL_ROUTER",
  "purpose": "识别下载来源并选择现成成熟工具；本技能不实现下载功能。",
  "routes": [
    {
      "source": "huggingface",
      "tool": "hf",
      "command": "hf download",
      "known_working_version": "1.19.0"
    },
    {
      "source": "github",
      "tool": "gh",
      "commands": [
        "gh release download",
        "gh repo clone"
      ],
      "known_working_version": "2.92.0"
    },
    {
      "source": "direct_url",
      "tool": "aria2c",
      "software": "aria2",
      "protocols": [
        "http",
        "https",
        "ftp"
      ],
      "known_working_version": "1.37.0"
    },
    {
      "source": "browser_session_required",
      "tool": "playwright-native-ai-browser",
      "version_policy": "managed_by_target_skill"
    }
  ],
  "version_policy": "Use the currently installed working version. Do not auto-upgrade. Handle version changes only when the selected tool is missing, fails, lacks a required capability, or the user explicitly asks.",
  "no_custom_download_logic": true,
  "no_validation_framework": true,
  "no_benchmark": true,
  "no_time_ledger": true
}
