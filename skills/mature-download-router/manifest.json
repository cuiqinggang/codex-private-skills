{
  "skill_id": "mature-download-router",
  "version": "1.0.0",
  "display_name": "成熟下载工具最短调用路由",
  "status": "STABLE_MINIMAL_ROUTER",
  "responsibility": "route_only",
  "decision_order": [
    {
      "priority": 1,
      "when": "browser_session_or_web_interaction_required",
      "tool": "playwright-native-ai-browser",
      "version": "managed_by_target_skill"
    },
    {
      "priority": 2,
      "when": "huggingface_resource",
      "tool": "hf",
      "command": "hf download",
      "known_working_version": "1.19.0"
    },
    {
      "priority": 3,
      "when": "github_native_task",
      "tool": "gh",
      "commands": [
        "gh release download",
        "gh repo clone"
      ],
      "known_working_version": "2.92.0",
      "exception": "direct_github_raw_url_goes_to_direct_url_route"
    },
    {
      "priority": 4,
      "when": "direct_http_https_ftp_file_url",
      "tool": "aria2c",
      "software": "aria2",
      "known_working_version": "1.37.0"
    }
  ],
  "version_policy": "use_installed_working_version_no_auto_upgrade",
  "insufficient_information": "determine_source_or_actual_download_url_first",
  "implementation_scope": "no_download_implementation"
}
